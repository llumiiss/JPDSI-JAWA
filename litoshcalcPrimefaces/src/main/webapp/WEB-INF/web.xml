<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">
    <display-name>Kalkulator Kredytowy</display-name>

<servlet>
        <servlet-name>Faces Servlet</servlet-name>
        <servlet-class>jakarta.faces.webapp.FacesServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>

    <servlet-mapping>
        <servlet-name>Faces Servlet</servlet-name>
        <url-pattern>*.xhtml</url-pattern>
    </servlet-mapping>

    <!-- Konfiguracja serwletu dla kalkulatora kredytowego -->
    <servlet>
        <servlet-name>CreditCalculatorServlet</servlet-name>
        <servlet-class>com.mycompany.litoshcalcprimefaces.servlets.CreditCalculatorServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>CreditCalculatorServlet</servlet-name>
        <url-pattern>/result</url-pattern>
    </servlet-mapping>

    <welcome-file-list>
        <welcome-file>index.xhtml</welcome-file> <!-- Użyj index.xhtml jako strony startowej -->
    </welcome-file-list>

</web-app>
